{
  "name": "devwallet",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "extension": {
    "name": "DevWallet",
    "description": "DevWallet enhances your Solidity development workflow. Works both with Anvil and Hardhat 3."
  },
  "scripts": {
    "aa:generate": "forge build --root contracts && bun scripts/generate-aa-code.ts",
    "anvil": "anvil --fork-url https://cloudflare-eth.com",
    "icons": "bun scripts/generate-icons.ts",
    "build": "tsc && bun run build:ds && bun run icons && vite build && bun run build:inpage",
    "build:ds": "vite build -c src/design-system/vite.config.ts",
    "build:inpage": "vite build -c vite.config.inpage.ts",
    "clean": "rimraf dist",
    "chrome": "web-ext run -t chromium --start-url \"http://localhost:5199\" --source-dir ./dist/dev",
    "contracts:build": "forge build --config-path test/contracts/foundry.toml && bun scripts/generate-typed-artifacts.ts",
    "contracts:deploy": "bun scripts/deploy-contracts.ts",
    "dev": "cross-env NODE_ENV=development bun run icons && bun run build:inpage && vite & (sleep 1 && bun run chrome)",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "preinstall": "bun scripts/preinstall.ts",
    "postinstall": "patch-package",
    "prepare": "bun run build:ds",
    "sync": "git submodule init && git submodule update",
    "test": "bun test src/",
    "typecheck": "tsc --noEmit",
    "zip": "web-ext build --source-dir ./dist/build --artifacts-dir ./dist --filename extension.zip",
    "crx": "crx3 -p ./build.pem -o ./dist/extension.crx ./dist/build",
    "package": "bun run clean && bun run build && bun run zip && bun run crx"
  },
  "dependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.4.0",
    "@fastify/deepmerge": "^3.2.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@openchainxyz/abi-guesser": "^1.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-form": "^0.1.16",
    "@radix-ui/react-polymorphic": "^0.0.14",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@react-hook/resize-observer": "^2.0.2",
    "@shazow/whatsabi": "^0.26.0",
    "@tanstack/query-async-storage-persister": "5.105.1",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-query-persist-client": "5.105.1",
    "@tanstack/react-virtual": "^3.14.25",
    "@total-typescript/ts-reset": "^0.6.1",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "abitype": "^1.3.0",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "eventemitter3": "^5.0.4",
    "human-id": "^4.2.2",
    "lucide-react": "^1.66.0",
    "mipd": "^0.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-flatten-children": "^1.1.2",
    "react-hook-form": "^7.91.0",
    "react-intersection-observer": "^10.1.0",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5",
    "remeda": "^2.58.0",
    "sonner": "^2.0.8",
    "use-sync-external-store": "^1.7.0",
    "viem": "^2.57.14",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@types/chroma-js": "^3.1.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/use-sync-external-store": "^1.7.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^5.2.0",
    "bun-types": "^1.4.4",
    "cross-env": "^10.1.0",
    "crx3": "^2.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globby": "^16.2.4",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "solmate": "^6.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-crx-hot-reload": "^1.0.4",
    "vite-tsconfig-paths": "^6.1.1",
    "web-ext": "^10.8.0",
    "webextension-polyfill": "^0.12.0",
    "which-pm-runs": "^2.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint && bun run typecheck"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.32"
  }
}
